CONNECTOR_PUBLIC_URL=https://connector.example.com
SCROLLMARKETER_APP_URL=https://app-automarketer.lovable.app
# Configure this public client ID in ChatGPT's OAuth settings. PKCE is mandatory.
CONNECTOR_CLIENT_ID=scrollmarketer-chatgpt
# Copy exact callback URI(s) shown by ChatGPT; no wildcards or guessed callbacks.
CONNECTOR_REDIRECT_URIS=https://example.com/replace-with-exact-chatgpt-callback
SUPABASE_URL=https://your-project.supabase.co
# Lovable Cloud public/anon key for verifying existing login.
SUPABASE_PUBLISHABLE_KEY=
CONNECTOR_BRIDGE_URL=https://your-project.supabase.co/functions/v1/chatgpt-connector-bridge
# Same random 32-byte base64url secret in Render and Lovable backend secrets only.
CONNECTOR_BRIDGE_SECRET=
# Leave empty for Lovable Cloud. Direct mode is only for a backend you control.
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787
